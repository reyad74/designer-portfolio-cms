# ══════════════════════════════════════════════════════════════════════
#  Portfolio CMS — environment configuration
#  Copy this file to `.env` and EDIT THE SECRETS before running:
#      cp .env.example .env
# ══════════════════════════════════════════════════════════════════════

# ── Admin account (created automatically on first start) ─────────────
# This is the login for #/admin — use a strong password in production!
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe#2026

# ── Security secrets (REQUIRED to change in production) ──────────────
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
DJANGO_SECRET_KEY=generate-a-long-random-hex-string-here
# Token-signing key for the admin login cookie. Generate a different one:
JWT_SECRET=generate-another-long-random-hex-string-here

# ── Public URL of the site (used for SEO metadata) ───────────────────
# Local: http://localhost:3000  |  Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Port the site is served on (docker-compose) ──────────────────────
APP_PORT=3000

# ── Demo content ──────────────────────────────────────────────────────
# 1 = seed demo portfolio content on first start (skipped automatically
# if data already exists). Set 0 to start with an EMPTY site.
SEED_DEMO=1

# ── Django ────────────────────────────────────────────────────────────
DJANGO_DEBUG=false
# Comma-separated hosts the API accepts. Add your domain / LAN IP here,
# e.g. "backend,localhost,127.0.0.1,yourdomain.com,192.168.1.50"
DJANGO_ALLOWED_HOSTS=backend,localhost,127.0.0.1
# Admin login session lifetime in seconds (default 2 hours)
JWT_TTL_SECONDS=7200

# ── Database (managed by docker-compose — normally leave as-is) ──────
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-this-db-password-too
