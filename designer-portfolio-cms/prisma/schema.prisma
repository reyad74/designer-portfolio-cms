// Portfolio CMS schema — 16 normalized models
// NOTE: SQLite in sandbox. For PostgreSQL production, change datasource provider to "postgresql"
// and update DATABASE_URL (all models are portable; String fields used in place of enums/JSON for portability).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN") // ADMIN | EDITOR
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Content: profile ────────────────────────────────────────────────────────

model Profile {
  id                 String  @id @default(cuid())
  name               String
  title              String
  tagline            String?
  shortBio           String
  bio                String
  photoUrl           String?
  email              String?
  phone              String?
  location           String?
  availabilityStatus String  @default("AVAILABLE") // AVAILABLE | LIMITED | UNAVAILABLE
  availabilityNote   String?
  yearsExperience    Int     @default(0)
  clientCount        Int     @default(0)
  projectCount       Int     @default(0)
  awardsCount        Int     @default(0)
  philosophyTitle    String?
  philosophy         String?
  interests          String?
  resumeUrl          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─── Portfolio ───────────────────────────────────────────────────────────────

model ProjectCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  order       Int       @default(0)
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id             String          @id @default(cuid())
  title          String
  slug           String          @unique
  summary        String
  description    String
  categoryId     String
  category       ProjectCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  clientName     String?
  projectDate    DateTime?
  year           Int?
  tools          String? // JSON string array
  thumbnailUrl   String?
  coverUrl       String?
  accentColor    String? // hex accent used in UI
  // Case-study narrative
  objectives     String?
  challenges     String?
  research       String?
  strategy       String?
  concept        String?
  colorPalette   String? // JSON string array of {name, hex}
  typography     String?
  applications   String?
  outcome        String?
  // Meta
  featured       Boolean @default(false)
  status         String  @default("DRAFT") // DRAFT | PUBLISHED
  order          Int     @default(0)
  viewCount      Int     @default(0)
  seoTitle       String?
  seoDescription String?
  images         ProjectImage[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([categoryId])
  @@index([status, featured])
  @@index([slug])
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
}

// ─── Services / Skills ───────────────────────────────────────────────────────

model Service {
  id               String  @id @default(cuid())
  title            String
  slug             String  @unique
  shortDescription String
  description      String
  deliverables     String? // JSON string array
  approach         String?
  icon             String? // lucide icon name
  order            Int     @default(0)
  featured         Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Skill {
  id       String  @id @default(cuid())
  name     String
  category String // SOFTWARE | EXPERTISE
  level    Int     @default(80) // 0-100
  icon     String?
  order    Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ─── Resume ──────────────────────────────────────────────────────────────────

model Experience {
  id          String    @id @default(cuid())
  company     String
  role        String
  description String?
  location    String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Education {
  id          String    @id @default(cuid())
  institution String
  degree      String
  field       String?
  description String?
  startDate   DateTime
  endDate     DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Certification {
  id            String    @id @default(cuid())
  name          String
  issuer        String
  issueDate     DateTime?
  credentialUrl String?
  description   String?
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Achievement {
  id           String   @id @default(cuid())
  title        String
  description  String?
  organization String?
  year         Int?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Testimonials ────────────────────────────────────────────────────────────

model Testimonial {
  id               String   @id @default(cuid())
  clientName       String
  company          String?
  photoUrl         String?
  review           String
  projectReference String?
  rating           Int? // 1-5, only when genuinely provided
  date             DateTime?
  published        Boolean  @default(false)
  featured         Boolean  @default(false)
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── Inquiries ───────────────────────────────────────────────────────────────

model ContactInquiry {
  id           String   @id @default(cuid())
  fullName     String
  email        String
  company      String?
  projectType  String
  budgetRange  String?
  timeline     String?
  message      String
  referenceUrl String?
  status       String   @default("UNREAD") // UNREAD | READ | ARCHIVED
  adminNotes   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ─── Social / Settings / Media ───────────────────────────────────────────────

model SocialLink {
  id       String  @id @default(cuid())
  platform String
  label    String
  url      String
  icon     String?
  order    Int     @default(0)
  visible  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebsiteSetting {
  id             String  @id @default("main")
  siteName       String  @default("Portfolio")
  logoText       String?
  logoUrl        String?
  tagline        String?
  metaTitle      String?
  metaDescription String?
  metaKeywords   String?
  ogImageUrl     String?
  faviconUrl     String?
  contactEmail   String?
  whatsappUrl    String?
  footerText     String?
  copyrightText  String?
  cvUrl          String?
  accentColor    String  @default("#C6FF00")
  updatedAt      DateTime @updatedAt
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  url          String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String?
  folder       String   @default("general")
  createdAt    DateTime @default(now())

  @@index([folder])
}
